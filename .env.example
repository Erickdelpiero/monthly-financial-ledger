# Copy to .env and fill in with LOCAL values. Never commit .env.
#
# There are three contexts. Each section says exactly which variables are read
# and by what.
#
#   A) The application at runtime  (uvicorn / the container / `alembic upgrade`)
#   B) The test suite, run on the host
#   C) The `docker compose` local stack
#
# Authoritative source: src/money_ledger/config.py.


# =====================================================================
# A) APPLICATION RUNTIME
# =====================================================================
# Read by: config.get_database_url() and config.get_api_token(), used by the
# FastAPI app (create_app) and by migrations/env.py.

# --- Database: EITHER a full URL, OR the five components (not both needed) ---
#
# config.get_database_url() logic:
#   1. If DATABASE_URL is set (non-empty) -> used verbatim.
#   2. Otherwise it requires DB_HOST, DB_NAME, DB_USER, DB_PASSWORD (all four),
#      and assembles the URL with sqlalchemy.URL.create (password is
#      percent-encoded, so @ : / # % and spaces are safe). DB_PORT is optional
#      and defaults to 5432.
#   3. If neither is present -> RuntimeError.
#
# Local host development typically uses the full URL:
DATABASE_URL=postgresql+psycopg://money_ledger_app:change-me-locally@localhost:5432/money_ledger_dev
#
# The component form (leave DATABASE_URL unset to use it):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=money_ledger_dev
# DB_USER=money_ledger_app
# DB_PASSWORD=change-me-locally

# --- Internal service token ---
# Read by: config.get_api_token() -> os.environ["API_INTERNAL_TOKEN"] (exact
# name). n8n presents this value in the HTTP header `X-API-Key` (PHASE-2.5 §6).
# A distinct strong value per environment; never the DB password.
API_INTERNAL_TOKEN=<SET_IN_RUNTIME>

# --- Not read by the application code (informational / future) ---
# ENVIRONMENT      : set by compose, but no code reads it yet.
# TELEGRAM token   : the backend never reads a Telegram token. The bot token
#                    lives only in n8n (a "Telegram API" credential).
# LLM_API_KEY      : no LLM provider is wired in v1 (app.state.llm is None).
ENVIRONMENT=local


# =====================================================================
# B) TEST SUITE (host-side)
# =====================================================================
# Read by: tests/conftest.py -> os.environ["TEST_DATABASE_URL"]. If unset,
# every DB-backed test skips. MUST be a local, disposable database, never
# production (PHASE-2.6 §16, PHASE-2.9 §2.4).
TEST_DATABASE_URL=postgresql+psycopg://money_ledger_app:change-me-locally@localhost:5432/money_ledger_test


# =====================================================================
# C) DOCKER COMPOSE LOCAL STACK  (`docker compose up`)
# =====================================================================
# Read by: docker-compose.yml. The `db` service is created with POSTGRES_*.
# The `api` / `migrate` services receive DB_HOST/DB_PORT/DB_NAME/DB_USER/
# DB_PASSWORD built from POSTGRES_* (host `db`) -- section A applies inside the
# containers. Do NOT set DATABASE_URL for the compose stack.
POSTGRES_USER=money_ledger_app
# A strong password with @ : / # % or spaces is fine -- the app URL-encodes it.
# If it contains `#`, quote the whole value:  POSTGRES_PASSWORD="p@ss#word"
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=money_ledger
# Host ports, bound to loopback only -- never exposed to the internet.
DB_HOST_PORT=5432
API_HOST_PORT=8000


# =====================================================================
# PRODUCTION / DIRECT DEPLOY ON THE VPS  (outside `docker compose`)
# =====================================================================
# When the container runs directly against `gonex-postgres` (e.g.
# `docker run ... money-ledger:...` or a one-off `alembic upgrade head`), pass
# the SAME runtime variables from section A. Use the COMPONENT form -- it is
# what worked for `alembic upgrade head` and it percent-encodes the password:
#
#   DB_HOST=gonex-postgres
#   DB_PORT=5432
#   DB_NAME=personal_finance_bot
#   DB_USER=money_ledger_app
#   DB_PASSWORD=<the strong password created during provisioning>
#   API_INTERNAL_TOKEN=<a fresh strong value; NOT the DB password>
#
# Do NOT also set DATABASE_URL (it would win and ignore the components).
# ENVIRONMENT=production  is optional and currently has no effect in code.
# No Telegram or LLM variable is needed by the container.
