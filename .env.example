# Copy to .env and fill in with LOCAL values only. Never commit .env.
# Block 1 only needs the database connection.

# Dev database — used by the application and by `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://money_ledger_app:change-me-locally@localhost:5432/money_ledger_dev

# Throwaway database used by the test suite.
# MUST be a local, disposable database — never production (PHASE-2.6 §16, PHASE-2.9 §2.4).
TEST_DATABASE_URL=postgresql+psycopg://money_ledger_app:change-me-locally@localhost:5432/money_ledger_test

# Internal service token n8n presents as the `X-API-Key` header (PHASE-2.5 §6).
# Distinct value per environment; never the DB password; never committed.
API_INTERNAL_TOKEN=<SET_IN_RUNTIME>
ENVIRONMENT=local

# --- Docker Compose local stack (`docker compose up`) ---
# The `db` service is created with these. The `api` / `migrate` services get
# their DATABASE_URL built from them automatically, pointing at host `db`
# (the DATABASE_URL / TEST_DATABASE_URL above are only for host-run tooling).
POSTGRES_USER=money_ledger_app
# A strong password with @ : / # % or spaces is fine — the app URL-encodes it.
# If it contains `#`, quote the whole value:  POSTGRES_PASSWORD="p@ss#word"
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=money_ledger
# Host ports, bound to loopback only — never exposed to the internet.
DB_HOST_PORT=5432
API_HOST_PORT=8000

# --- introduced in later blocks (names per PHASE-2.11 §3) ---
# TELEGRAM_BOT_TOKEN=<SET_IN_RUNTIME>
# LLM_API_KEY=<SET_IN_RUNTIME>
